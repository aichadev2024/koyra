# Copiez ce fichier en .env pour le développement local, puis adaptez les valeurs.
# En production (Render), ces variables se règlent dans le dashboard.

# --- Base ---
SECRET_KEY=changez-moi-par-une-chaine-longue-et-aleatoire
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Base de données ---
# Local : mot de passe de votre PostgreSQL (l'URL est reconstruite automatiquement)
DB_PASSWORD=
# Production : URL complète fournie par l'hébergeur (prioritaire si présente)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_SSL_REQUIRE=false

# --- Fichiers média (images uploadées) ---
# MEDIA_ROOT=/var/media

# --- E-mail ---
# Laisser vide -> les e-mails s'affichent dans la console (dev).
# Pour un envoi réel, renseigner un compte SMTP :
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Koyra Distribution <no-reply@koyradistribution.com>
CONTACT_NOTIFICATION_EMAIL=contact@koyradistribution.com

# --- Page d'installation du 1er compte admin ---
# Laisser vide => page /installation/<jeton>/ désactivée (404).
# Mettre une valeur longue et aléatoire pour l'activer (le temps de créer
# le premier admin ; elle se coupe toute seule ensuite).
ADMIN_SETUP_TOKEN=

# --- Sécurité (production uniquement, ignoré si DEBUG=true) ---
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=2592000
